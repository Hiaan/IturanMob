// =============================================================================
// Finance AI — Modelo de dados
//
// Convenções:
// - Valores monetários: inteiros em CENTAVOS (Int). Nunca ponto flutuante.
//   Limite por valor individual: R$ 10.000.000,00 (validado na aplicação).
// - Datas de calendário (data da compra, competência, vencimento) usam @db.Date
//   e são representadas em JS como Date à meia-noite UTC do dia local.
// - Todo dado financeiro pertence a uma Household (família) e TODA consulta
//   é filtrada por householdId (isolamento entre famílias).
// - Transaction = evento econômico (lançamento).
//   LedgerEntry = movimento de caixa em uma conta (derivado da transação).
//   Installment = parcela em fatura de cartão (derivado da transação).
//   Saldos são sempre calculados a partir do ledger (fonte única da verdade).
// =============================================================================

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// -----------------------------------------------------------------------------
// Enums
// -----------------------------------------------------------------------------

enum MemberRole {
  OWNER
  ADMIN
  MEMBER
  VIEWER
}

/// Indexador do rendimento automático de contas de investimento.
enum YieldIndex {
  CDI
  SELIC
  IPCA
  PREFIXED
}

enum AccountType {
  CHECKING
  SAVINGS
  WALLET
  INVESTMENT
  DIGITAL
  OTHER
}

enum Visibility {
  SHARED
  PRIVATE
}

enum TransactionType {
  EXPENSE
  INCOME
  TRANSFER
  CARD_PAYMENT
  ADJUSTMENT
}

enum TransactionStatus {
  CONFIRMED
  PENDING
}

enum PaymentMethod {
  PIX
  DEBIT_CARD
  CREDIT_CARD
  CASH
  BANK_SLIP
  BANK_TRANSFER
  AUTO_DEBIT
  VOUCHER
  OTHER
}

/// Natureza econômica do lançamento: da família (pessoal) ou da empresa. Só afeta relatórios e
/// análises — saldo, ledger, fatura e projeção de caixa nunca mudam por causa dela.
enum TransactionScope {
  PERSONAL
  BUSINESS
}

/// Grupo do WhatsApp sem natureza atribuída: perguntar PF/Empresa ou usar o padrão da família.
enum UnassignedNatureMode {
  ASK
  FAMILY_DEFAULT
}

/// Recorte padrão dos relatórios da família (Pessoal, Empresa ou Tudo).
enum ReportScope {
  PERSONAL
  BUSINESS
  ALL
}

/// Por que um lançamento foi desconsiderado nos relatórios (continua no saldo, no ledger e na fatura).
enum ReportExclusionReason {
  /// Repasse de cliente: o dinheiro recebido/gasto é de outra pessoa (ex.: anúncios pagos no cartão).
  CLIENT_PASSTHROUGH
  REIMBURSEMENT
  OTHER
}

enum TransactionSource {
  MANUAL
  WHATSAPP_TEXT
  WHATSAPP_AUDIO
  WHATSAPP_IMAGE
  DASHBOARD_CHAT
  IMPORT
  RECURRING
  SYSTEM
}

enum Ownership {
  SHARED
  INDIVIDUAL
}

enum CategoryKind {
  EXPENSE
  INCOME
}

enum LedgerEntryKind {
  EXPENSE
  INCOME
  TRANSFER_OUT
  TRANSFER_IN
  CARD_PAYMENT
  ADJUSTMENT
}

enum RecurrenceFrequency {
