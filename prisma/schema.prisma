}

enum RuleMatchType {
  CONTAINS
  EQUALS
  STARTS_WITH
  REGEX
}

enum RuleSource {
  USER
  ASSISTANT
  WHATSAPP
}

enum ReportType {
  WEEKLY
  MONTHLY
  CUSTOM
}

enum AccountingRegime {
  ACCRUAL
  CASH
}

enum ConversationChannel {
  WHATSAPP
  DASHBOARD
}

enum ClarificationKind {
  MISSING_FIELDS
  CHOOSE_TRANSACTION
  CONFIRM_TRANSACTION
  CONFIRM_DUPLICATE
  CONFIRM_DELETE
