  DISCARDED
  FAILED
}

enum ImportStatus {
  PREVIEW
  IMPORTED
  UNDONE
  FAILED
}

enum ImportRowStatus {
  NEW
  DUPLICATE
  MATCHED
  DIVERGENT
  SKIPPED
  IMPORTED
  ERROR
}

enum PendingType {
  CONFIRMATION
  UNCATEGORIZED
