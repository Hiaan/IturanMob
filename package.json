{
  "name": "finance-ai",
  "version": "0.1.0",
  "private": true,
  "description": "Finance AI — sistema inteligente de gestão financeira familiar com WhatsApp e IA",
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "dev": "next dev -p 3000",
    "dev:worker": "tsx watch --tsconfig tsconfig.json src/worker/index.ts",
    "build": "prisma generate && next build",
    "start": "next start -p 3000",
    "worker": "tsx --tsconfig tsconfig.json src/worker/index.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:e2e": "playwright test",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "tsx --tsconfig tsconfig.json prisma/seed.ts",
    "db:studio": "prisma studio",
    "setup": "tsx --tsconfig tsconfig.json scripts/setup.ts",
    "vapid:generate": "tsx --tsconfig tsconfig.json scripts/generate-vapid.ts",
    "backup": "tsx --tsconfig tsconfig.json scripts/backup.ts",
    "backup:verify": "tsx --tsconfig tsconfig.json scripts/backup.ts --verify"
  },
  "prisma": {
    "seed": "tsx --tsconfig tsconfig.json prisma/seed.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.134.0",
    "@date-fns/tz": "1.5.0",
    "@hookform/resolvers": "5.9.1",
    "@prisma/client": "6.19.3",
    "@tanstack/react-query": "5.104.2",
    "baileys": "7.0.0-rc14",
    "bullmq": "5.81.5",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "1.1.1",
    "date-fns": "4.4.0",
    "exceljs": "4.4.0",
    "geist": "1.7.2",
    "ioredis": "5.11.1",
    "lucide-react": "1.57.0",
    "next": "15.5.28",
    "next-themes": "0.4.6",
    "openai": "7.34.0",
    "papaparse": "5.7.0",
    "pdfkit": "0.20.2",
    "pino": "9.14.0",
    "prisma": "6.19.3",
    "qrcode": "1.5.4",
    "radix-ui": "1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-hook-form": "7.90.0",
    "recharts": "3.10.1",
    "sonner": "2.0.8",
    "tailwind-merge": "3.7.0",
    "tsx": "4.23.15",
    "unpdf": "1.8.1",
    "web-push": "3.6.7",
    "zod": "4.6.7"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/client",
      "@prisma/engines",
      "prisma",
      "esbuild",
      "msgpackr-extract",
      "protobufjs",
      "baileys",
      "sharp",
      "@tailwindcss/oxide",
      "unrs-resolver"
    ]
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "22.20.5",
    "@types/papaparse": "5.5.2",
    "@types/pdfkit": "0.17.6",
    "@types/qrcode": "1.5.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/web-push": "3.6.4",
    "pino-pretty": "13.2.0",
    "postcss": "^8.5.30",
    "tailwindcss": "4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "5.9.3",
    "vitest": "3.2.7"
  }
}
