# =============================================================================
# Finance AI — configuração
#
# 1. cp .env.example .env
# 2. pnpm run setup        → gera SESSION_SECRET, ENCRYPTION_KEY e POSTGRES_PASSWORD aleatórios
# 3. Revise os valores abaixo. NUNCA faça commit do .env.
#
# Chaves de API também podem ser cadastradas pela interface (Integrações → IA);
# nesse caso ficam criptografadas (AES-256-GCM) no banco com a ENCRYPTION_KEY.
# =============================================================================

# ---- Aplicação ---------------------------------------------------------------
NODE_ENV=development
# URL pública (usada em links de convite, cookies seguros e verificação de origem/CSRF).
APP_URL=http://localhost:3000
# Porta publicada pelo docker compose.
WEB_PORT=3000
# Fuso padrão de novas famílias (cada família pode alterar em Configurações).
DEFAULT_TIMEZONE=America/Recife
# Cadastro público de novas famílias. O primeiro cadastro é sempre permitido;
# depois disso, novos membros entram por convite. Mantenha "false" em produção.
ALLOW_REGISTRATION=false
# Força cookies "Secure" (automático quando APP_URL começa com https://).
SECURE_COOKIES=false
LOG_LEVEL=info
# Logs coloridos no desenvolvimento (0 desativa).
LOG_PRETTY=1

# ---- Segredos (obrigatórios) -------------------------------------------------
# Assinatura das sessões. Mínimo 32 caracteres. Gere com: openssl rand -base64 48
SESSION_SECRET=
# Chave AES-256 (32 bytes em base64) para criptografar chaves de API, sessão do WhatsApp e
# credenciais. Gere com: openssl rand -base64 32
# ATENÇÃO: trocar esta chave torna ilegíveis as credenciais já salvas (será preciso recadastrá-las).
ENCRYPTION_KEY=

# ---- Banco de dados (PostgreSQL 16) e Redis -----------------------------------
# Usados pelo docker compose para criar o banco:
POSTGRES_USER=finance
# Use apenas letras e números (a senha também entra na DATABASE_URL).
POSTGRES_PASSWORD=
POSTGRES_DB=finance_ai
# Execução local (fora do Docker). No docker compose esta URL é montada automaticamente.
DATABASE_URL=postgresql://finance:finance@localhost:5432/finance_ai?schema=public
REDIS_URL=redis://localhost:6379
# Banco usado pelos testes de integração (é apagado a cada execução!).
TEST_DATABASE_URL=postgresql://finance:finance@localhost:5432/finance_ai_test?schema=public
# PRISMA_LOG=1  → registra as consultas SQL (apenas para depuração local)

# ---- Arquivos, retenção e backups ---------------------------------------------
# Anexos (áudios, comprovantes). Fora da pasta pública; servidos apenas a membros autenticados.
STORAGE_DIR=./storage
BACKUP_DIR=./backups
# Intervalo do backup automático em horas (0 desativa) e quantos manter.
BACKUP_INTERVAL_HOURS=24
BACKUP_KEEP=14
# pg_dump/pg_restore com versão >= à do servidor (16). Na imagem Docker já vêm configurados.
PG_DUMP_PATH=pg_dump
PG_RESTORE_PATH=pg_restore

# ---- Inteligência artificial ---------------------------------------------------
# LOCAL = motor heurístico em português, roda no servidor e não envia nada a terceiros.
# Provedores externos só são usados após a família autorizar em Configurações → Privacidade e IA.
AI_DEFAULT_PROVIDER=LOCAL
AI_TIMEOUT_MS=45000

# Anthropic (Claude)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
ANTHROPIC_FAST_MODEL=claude-haiku-5-5

# OpenAI
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=gpt-4.1-mini

# Qualquer API compatível com OpenAI (Ollama, vLLM, LM Studio, OpenRouter...)
# Ex.: com o perfil "ollama" do compose → http://ollama:11434/v1
OPENAI_COMPATIBLE_API_KEY=
OPENAI_COMPATIBLE_BASE_URL=
OPENAI_COMPATIBLE_MODEL=

# ---- Transcrição de áudio (API compatível com Whisper) ---------------------------
# none | openai | openai_compatible
# Ex. local: TRANSCRIPTION_PROVIDER=openai_compatible e TRANSCRIPTION_BASE_URL=http://whisper:8000/v1
TRANSCRIPTION_PROVIDER=none
TRANSCRIPTION_API_KEY=
TRANSCRIPTION_BASE_URL=
TRANSCRIPTION_MODEL=whisper-1
# Whisper próprio (docker compose --profile whisper): modelo e limite de memória do serviço.
# Com TRANSCRIPTION_PROVIDER=openai_compatible, "whisper-1" vira Systran/faster-whisper-<WHISPER_MODEL>.
WHISPER_MODEL=small
WHISPER_MEM_LIMIT=2g
FFMPEG_PATH=ffmpeg

# ---- WhatsApp -----------------------------------------------------------------------
# SIMULATOR  = simulador de desenvolvimento (claramente identificado na interface; não conecta ao WhatsApp).
# CLOUD_API  = API oficial do WhatsApp Business (Meta). Requer número comercial e app na Meta.
# BAILEYS    = biblioteca NÃO OFICIAL via QR Code. Não é autorizada pela Meta: há risco de bloqueio
#              do número e de parar de funcionar a qualquer momento. Leia docs/WHATSAPP.md antes de usar.
WHATSAPP_DEFAULT_PROVIDER=SIMULATOR
# Desative o simulador em produção.
WHATSAPP_ENABLE_SIMULATOR=true
# Prefixo das respostas do sistema no grupo (evita que o próprio bot reprocesse as respostas).
WHATSAPP_BOT_PREFIX=🤖

# WhatsApp Cloud API (oficial) — webhook: {APP_URL}/api/webhooks/whatsapp
WHATSAPP_CLOUD_ACCESS_TOKEN=
WHATSAPP_CLOUD_PHONE_NUMBER_ID=
WHATSAPP_CLOUD_VERIFY_TOKEN=
WHATSAPP_CLOUD_APP_SECRET=
WHATSAPP_CLOUD_API_VERSION=v21.0
# Família que recebe as mensagens da Cloud API (id exibido em Integrações → WhatsApp).
WHATSAPP_CLOUD_HOUSEHOLD_ID=

# ---- Notificações push (app instalado no celular) ---------------------------------------
# Gere as chaves NO SERVIDOR com `pnpm vapid:generate` e cole aqui (a privada nunca vai para o código
# nem para o navegador). Sem as chaves, o botão "Ativar notificações" fica indisponível.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com

# ---- Rendimento automático de investimentos --------------------------------------------
# O worker busca CDI/Selic/IPCA no Banco Central (API pública SGS, sem credencial) e lança o
# rendimento das contas de investimento configuradas. Nenhum dado da família é enviado.
INVESTMENT_YIELD_ENABLED=true
BCB_SGS_URL=https://api.bcb.gov.br/dados/serie/bcdata.sgs

# ---- Worker e limites -------------------------------------------------------------------
WORKER_CONCURRENCY=2
RATE_LIMIT_LOGIN_PER_15MIN=10
RATE_LIMIT_REGISTER_PER_HOUR=5
RATE_LIMIT_API_PER_MIN=300
